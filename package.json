{
  "name": "tanstack-viteplus",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "dev:docker": "vp dev --host 0.0.0.0 --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "storybook": "storybook dev -p 6006",
    "storybook:docker": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "start": "node .output/server/index.mjs",
    "db:seed": "vp exec tsx src/lib/server/seed.ts",
    "docker:dev": "docker compose --profile dev up --build app-dev",
    "docker:prod": "docker compose --profile prod up --build app-prod",
    "docker:storybook": "docker compose --profile storybook up --build app-storybook",
    "test": "vp test run",
    "prepare": "vp config",
    "graphify:root": "node scripts/graphify-root.mjs",
    "graphify:setup": "vp run graphify:root",
    "graphify:update": "vp run graphify:root && graphify update . --force && graphify export callflow-html && vp run graphify:root"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.46",
    "@tanstack/router-plugin": "^1.168.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260810-113911-16ff2809",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.9",
    "vite-plus": "^0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.3.14"
}

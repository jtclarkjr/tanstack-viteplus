{
  "name": "tanstack-viteplus",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "dev:docker": "vp dev --host 0.0.0.0 --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "storybook": "storybook dev -p 6006",
    "storybook:docker": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "start": "node .output/server/index.mjs",
    "typecheck": "vp exec tsgo --noEmit",
    "db:push": "vp exec drizzle-kit push",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate": "vp exec drizzle-kit migrate",
    "db:seed": "vp exec tsx src/lib/server/seed.ts",
    "docker:dev": "docker compose --profile dev up --build app-dev",
    "docker:prod": "docker compose --profile prod up --build app-prod",
    "docker:storybook": "docker compose --profile storybook up --build app-storybook",
    "test": "vp test run",
    "prepare": "vp config",
    "graphify:root": "node scripts/graphify-root.mjs",
    "graphify:setup": "vp run graphify:root",
    "graphify:update": "vp run graphify:root && graphify update . --force && graphify export callflow-html && vp run graphify:root"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.52.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260810-113911-16ff2809",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0",
    "vite-plus": "^1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.3.14"
}

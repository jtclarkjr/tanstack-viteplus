{
  "name": "tanstack-viteplus",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "vp check --no-fmt --no-lint",
    "db:push": "vp exec void db push",
    "db:generate": "vp exec void db generate",
    "db:migrate": "vp exec void db migrate",
    "db:seed": "vp exec void db execute --file db/seed.sql",
    "deploy": "vp exec void deploy --platform cloudflare",
    "test": "vp test run",
    "prepare": "vp config",
    "graphify:root": "node scripts/graphify-root.mjs",
    "graphify:setup": "vp run graphify:root",
    "graphify:update": "vp run graphify:root && graphify update . --force && graphify export callflow-html && vp run graphify:root"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/router-plugin": "^1.168.45",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "void": "^1.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.3.14"
}
